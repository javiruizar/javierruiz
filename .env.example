# Copia este archivo como .env.local (desarrollo) y configura las mismas variables en Vercel.

# Formulario de contacto (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Buzón que recibe los mensajes
CONTACT_TO_EMAIL=javiruizar@gmail.com
# Remitente: dominio verificado en Resend. Hasta verificarlo, usa "onboarding@resend.dev"
# (solo puede enviar al email con el que te registraste en Resend).
CONTACT_FROM_EMAIL="Web javierruiz.org <noreply@javierruiz.org>"

# Google Analytics 4 (Administrar → Flujos de datos → ID de medición). Vacío = GA desactivado.
NEXT_PUBLIC_GA_ID=
